+
+// One Switch 2 Joy-Con held sideways through KartPad's experimental Bluetooth
+// LE bridge. The bridge already rotates the face buttons by position, so the
+// bottom button accelerates and the right one brakes like a single Joy-Con on
+// Switch. SL/SR are the shoulders, the rail bumper (L or R) lands on D-pad Up
+// for tricks, and the rail trigger (ZL or ZR) is the right trigger.
+constexpr std::array<const char*, PAD_BUTTON_COUNT> kJoyCon2SidewaysPreset = {
+    "south",          // A: bottom face button
+    "east",           // B: right face button
+    "north",          // X: top face button
+    "west",           // Y: left face button
+    "start",          // Start: Plus (R) / Capture (L)
+    "back",           // Z: C (R) / Minus (L)
+    "left_shoulder",  // L: SL
+    "right_shoulder", // R: SR
     "dpad_up", "dpad_down", "dpad_left", "dpad_right",
 };
 
