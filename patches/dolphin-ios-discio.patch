+// Copyright 2026 KartPad contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "InputCommon/GCAdapter.h"
+
+#include <functional>
+
+#include "Core/HW/SI/SI_DeviceGCController.h"
+
+namespace GCAdapter
+{
+void Init() {}
+void ResetRumble() {}
+void Shutdown() {}
+void SetAdapterCallback(std::function<void(void)> func) { (void)func; }
+GCPadStatus Input(int chan)
+{
+  (void)chan;
+  return {};
+}
+void Output(int chan, u8 rumble_command)
+{
+  (void)chan;
+  (void)rumble_command;
+}
+bool IsDetected(const char** error_message)
+{
+  if (error_message)
+    *error_message = "USB GameCube adapter is not supported on iOS";
+  return false;
+}
+bool DeviceConnected(int chan)
+{
+  (void)chan;
+  return false;
+}
+void ResetDeviceType(int chan) { (void)chan; }
+double GetCurrentPollRate() { return 0.0; }
+}  // namespace GCAdapter
